---
import SiteHeader from '../components/SiteHeader.astro';
import { SITE_DESCRIPTION, SITE_NAME } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  /** For pages served at URLs that aren't their own, like the 404 page. */
  noindex?: boolean;
}

const { title, noindex = false } = Astro.props;
const canonical = noindex ? undefined : new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {SITE_NAME}</title>
    <meta name="description" content={SITE_DESCRIPTION} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={SITE_DESCRIPTION} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Hebrew:wght@400;600;700&family=Noto+Sans:ital,wght@0,400;0,600;0,700;0,800;1,400&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <SiteHeader />
    <main id="content">
      <article class="panel">
        <h2 class="page-title">{title}</h2>
        <slot />
      </article>
    </main>
  </body>
</html>
