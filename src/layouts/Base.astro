---
import SiteHeader from '../components/SiteHeader.astro';
import { OG_IMAGE, SITE_DESCRIPTION, SITE_NAME } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  /** What search results and link previews show for this page. */
  description?: string;
  /** For pages served at URLs that aren't their own, like the 404 page. */
  noindex?: boolean;
  /** schema.org JSON-LD objects describing the page. */
  structuredData?: object[];
}

const { title, description = SITE_DESCRIPTION, noindex = false, structuredData = [] } = Astro.props;
const canonical = noindex ? undefined : new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(OG_IMAGE.path, Astro.site).href;
// `<` would let a string in the data close the script element early.
const jsonLd = (data: object) => JSON.stringify(data).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {SITE_NAME}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={OG_IMAGE.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Hebrew:wght@400;600;700&family=Noto+Sans:ital,wght@0,400;0,600;0,700;0,800;1,400&display=swap"
    />
    {structuredData.map((data) => <script type="application/ld+json" set:html={jsonLd(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <SiteHeader />
    <main id="content">
      <article class="panel">
        <h1 class="page-title">{title}</h1>
        <slot />
      </article>
    </main>
  </body>
</html>
