---
import Base from '../layouts/Base.astro';
import RoleCategory from '../components/RoleCategory.astro';
import { parseGlossary } from '../lib/glossary';
import { renderMarkdown } from '../lib/markdown';
import { groupsWithCategories } from '../lib/roles';
import glossary from '../content/glossary.md?raw';
import intro from '../content/roles-intro.md?raw';

const glossaryTerms = new Map(parseGlossary(glossary).entries.map((e) => [e.slug, e.term]));

const description =
  "What every role on The Night House's Discord server means: staff, access, identities, " +
  'DM and ping preferences, paths, disciplines and more.';
---

<Base title="Roles" {description}>
  <div class="callout prose" set:html={renderMarkdown(intro)} />
  <div class="roles-filter-bar">
    <input
      type="search"
      id="roles-filter"
      class="roles-filter"
      placeholder="Filter roles"
      aria-label="Filter roles by name, description or category"
      aria-controls="role-categories"
      aria-describedby="roles-filter-status"
      autocomplete="off"
      hidden
    />
    <p class="roles-filter-status" id="roles-filter-status" role="status"></p>
  </div>
  <div class="role-categories" id="role-categories">
    {
      groupsWithCategories().map(({ group, categories }) => (
        <section class="role-group" aria-labelledby={group.id}>
          <h2 class="role-group-heading" id={group.id}>
            {group.name}
          </h2>
          {categories.map(({ category, nodes }) => (
            <RoleCategory {category} {nodes} {glossaryTerms} />
          ))}
        </section>
      ))
    }
  </div>
</Base>

<script>
  // A link to /roles/#some-category should land on that category already expanded.
  const openFromHash = () => {
    let id = location.hash.slice(1);
    try {
      id = decodeURIComponent(id);
    } catch {
      // A malformed escape like `#%` just means no category matches.
    }
    const target = id && document.getElementById(id);
    if (target instanceof HTMLDetailsElement) {
      target.open = true;
      target.scrollIntoView();
    }
  };
  openFromHash();
  window.addEventListener('hashchange', openFromHash);
</script>

<script>
  import { filterMatches, foldForSearch } from '../lib/search';

  const filter = document.getElementById('roles-filter') as HTMLInputElement;
  const status = document.getElementById('roles-filter-status')!;
  const categories = [...document.querySelectorAll<HTMLDetailsElement>('.role-category')].map(
    (details) => {
      const roles = [...details.querySelectorAll<HTMLElement>('.role')];
      return {
        details,
        name: foldForSearch(details.querySelector('summary')?.textContent ?? ''),
        roles,
        // A glossary link's term is searchable, its "In the glossary" label isn't.
        texts: roles.map((role) =>
          foldForSearch(
            [...role.querySelectorAll('.role-name, .role-text, .role-glossary a')]
              .map((el) => el.textContent)
              .join(' '),
          ),
        ),
        notes: [...details.querySelectorAll<HTMLElement>('.role-category-body > .callout')],
      };
    },
  );
  // Which categories the reader had open before filtering, to restore when the filter clears.
  let openBefore: boolean[] | undefined;
  // The count is announced once typing pauses, not on every keystroke.
  let announceTimer: ReturnType<typeof setTimeout> | undefined;
  const announce = (text: string) => {
    clearTimeout(announceTimer);
    announceTimer = setTimeout(() => (status.textContent = text), text ? 500 : 0);
  };

  const groups = [...document.querySelectorAll<HTMLElement>('.role-group')];
  // A group whose categories the filter has all hidden goes too, heading included.
  const hideEmptyGroups = () => {
    for (const group of groups) {
      group.hidden = !group.querySelector('.role-category:not([hidden])');
    }
  };

  const applyFilter = () => {
    const query = filter.value.trim();
    if (query === '') {
      categories.forEach((c, i) => {
        c.details.hidden = false;
        c.details.open = openBefore?.[i] ?? c.details.open;
        c.roles.forEach((role) => (role.hidden = false));
        c.notes.forEach((note) => (note.hidden = false));
      });
      openBefore = undefined;
      hideEmptyGroups();
      announce('');
      return;
    }
    openBefore ??= categories.map((c) => c.details.open);
    let shown = 0;
    for (const c of categories) {
      // A matching category name shows the whole category.
      const [nameMatches] = filterMatches([c.name], query);
      const keep = nameMatches ? c.roles.map(() => true) : filterMatches(c.texts, query);
      c.roles.forEach((role, i) => (role.hidden = !keep[i]));
      c.notes.forEach((note) => (note.hidden = !nameMatches));
      const count = keep.filter(Boolean).length;
      // A category matched by name stays visible even if it holds only notes.
      const visible = count > 0 || (nameMatches && c.notes.length > 0);
      c.details.hidden = !visible;
      c.details.open = visible;
      shown += count;
    }
    hideEmptyGroups();
    if (shown === 0) announce('No roles match that filter.');
    else announce(shown === 1 ? '1 role matches.' : `${shown} roles match.`);
  };

  filter.addEventListener('input', applyFilter);
  filter.hidden = false;
</script>
