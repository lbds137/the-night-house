---
import Base from '../layouts/Base.astro';
import DiscordInvite from '../components/DiscordInvite.astro';
import PermalinkCopier from '../components/PermalinkCopier.astro';
import { renderMarkdown } from '../lib/markdown';
import { numberRules } from '../lib/permalinks';
import rules from '../content/rules.md?raw';

const description =
  "The Night House's rules: respect each other, no bigotry or harassment, and how DMs, " +
  'staff, tickets and moderation work on our Left Hand Path Discord server.';
---

<Base title="Rules" {description}>
  <div class="prose rules" set:html={numberRules(renderMarkdown(rules))} />
  {/* Welcome's How to join sends people here first; the way on is right below the rules. */}
  <DiscordInvite />
  <PermalinkCopier />
</Base>
