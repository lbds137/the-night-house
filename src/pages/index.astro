---
import Base from '../layouts/Base.astro';
import DiscordInvite from '../components/DiscordInvite.astro';
import { renderMarkdown } from '../lib/markdown';
import welcome from '../content/welcome.md?raw';
import howToJoin from '../content/how-to-join.md?raw';
import { FOOTER_LINKS, SITE_DESCRIPTION } from '../lib/site';

const site = new URL('/', Astro.site).href;
const profiles = FOOTER_LINKS.filter((link) => link.profile).map((link) => link.href);
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'The Night House',
    alternateName: 'בית הלילה',
    url: site,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'The Night House',
    alternateName: 'בית הלילה',
    url: site,
    logo: new URL('/android-chrome-512x512.png', site).href,
    description: SITE_DESCRIPTION,
    sameAs: profiles,
  },
];
---

<Base title="Welcome" structuredData={structuredData}>
  {/* First, so it's on a phone's first screen: the header's tagline already says what we are. */}
  <DiscordInvite />
  <div class="prose welcome-text" set:html={renderMarkdown(welcome)} />
  <section class="how-to-join" aria-labelledby="how-to-join">
    <h2 id="how-to-join">How to join</h2>
    <div class="prose" set:html={renderMarkdown(howToJoin)} />
  </section>
</Base>
