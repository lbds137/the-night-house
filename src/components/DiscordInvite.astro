---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import TitleParts from './TitleParts.astro';
import { DISCORD_INVITE_CODE, DISCORD_INVITE_URL, SITE_TITLE } from '../lib/site';
---

<section
  class="invite"
  id="invite"
  data-invite-code={DISCORD_INVITE_CODE}
  aria-label="Discord invite"
>
  <p class="invite-eyebrow">You've been invited to join a server</p>
  <div class="invite-body">
    <Image class="invite-icon" src={logo} alt="" width={56} densities={[1, 2, 3]} />
    <div class="invite-info">
      <h2 class="invite-name"><TitleParts title={SITE_TITLE} /></h2>
      <p class="invite-stats" hidden>
        <span class="invite-stat"
          ><span class="invite-dot online"></span><span data-online></span> Online</span
        >
        <span class="invite-stat"
          ><span class="invite-dot members"></span><span data-members></span> Members</span
        >
      </p>
    </div>
    <a class="invite-join" href={DISCORD_INVITE_URL} target="_blank" rel="noopener">Join</a>
  </div>
</section>

<script>
  import { titleParts } from '../lib/site';

  // The card works as a plain link; live counts, name and icon are an enhancement.
  interface InviteResponse {
    approximate_member_count: number;
    approximate_presence_count: number;
    guild: { id: string; name: string; icon: string | null };
  }

  for (const card of document.querySelectorAll<HTMLElement>('.invite[data-invite-code]')) {
    const code = card.dataset.inviteCode;
    fetch(`https://discord.com/api/v10/invites/${code}?with_counts=true`)
      .then((response) => (response.ok ? response.json() : Promise.reject(response.status)))
      .then((invite: InviteResponse) => {
        const format = (n: number) => n.toLocaleString('en');
        card.querySelector('[data-online]')!.textContent = format(invite.approximate_presence_count);
        card.querySelector('[data-members]')!.textContent = format(invite.approximate_member_count);
        card.querySelector('.invite-stats')!.removeAttribute('hidden');
        // The server's current name, in the same wrap-as-a-unit halves as TitleParts.astro.
        const spans = titleParts(invite.guild.name).map((part) => {
          const span = document.createElement('span');
          span.textContent = part.text;
          if (part.separator) span.setAttribute('aria-hidden', 'true');
          if (part.hebrew) {
            span.lang = 'he';
            span.dir = 'rtl';
          }
          return span;
        });
        card.querySelector('.invite-name')!.replaceChildren(...spans);
        if (invite.guild.icon) {
          const icon = card.querySelector<HTMLImageElement>('.invite-icon')!;
          // srcset wins over src, so drop the local logo's densities first.
          icon.removeAttribute('srcset');
          icon.src = `https://cdn.discordapp.com/icons/${invite.guild.id}/${invite.guild.icon}.png?size=128`;
        }
      })
      .catch((error) => console.warn('Discord invite lookup failed:', error));
  }
</script>
